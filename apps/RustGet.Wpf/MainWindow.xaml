<Window x:Class="RustGet.Native.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="RustGet" Height="760" Width="1120" MinHeight="640" MinWidth="960"
        WindowStartupLocation="Manual" Left="24" Top="24"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#0C0E12" Foreground="#F7F5F2" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#0C0E12" />
        <SolidColorBrush x:Key="Sidebar" Color="#11141A" />
        <SolidColorBrush x:Key="Panel" Color="#171B22" />
        <SolidColorBrush x:Key="Panel2" Color="#1D222B" />
        <SolidColorBrush x:Key="Line" Color="#2C333E" />
        <SolidColorBrush x:Key="Text" Color="#F7F5F2" />
        <SolidColorBrush x:Key="Muted" Color="#A2AAB6" />
        <SolidColorBrush x:Key="Orange" Color="#FF8A4C" />
        <SolidColorBrush x:Key="Green" Color="#5EE0A0" />
        <SolidColorBrush x:Key="Blue" Color="#6EA8FE" />
        <SolidColorBrush x:Key="Yellow" Color="#F5C451" />
        <SolidColorBrush x:Key="Red" Color="#FF7373" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,14" />
        </Style>

        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Panel2}" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#2B3340" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#151A21" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="{StaticResource Orange}" />
            <Setter Property="Foreground" Value="#261207" />
            <Setter Property="BorderBrush" Value="{StaticResource Orange}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="GhostIcon" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#C8CEDA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#252B35" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#343C49" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="#D7DCE5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Surface" Background="Transparent" CornerRadius="8" Padding="10,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#1B212A" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#33231A" />
                                <Setter Property="Foreground" Value="#FFC29C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1A1F27" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource Orange}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Background" Value="#252B35" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="completed">
                    <Setter Property="Background" Value="#123529" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="downloading">
                    <Setter Property="Background" Value="#122B45" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="paused">
                    <Setter Property="Background" Value="#3A2E12" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="failed">
                    <Setter Property="Background" Value="#3B1719" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#CBD2DD" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="completed">
                    <Setter Property="Foreground" Value="{StaticResource Green}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="downloading">
                    <Setter Property="Foreground" Value="{StaticResource Blue}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="paused">
                    <Setter Property="Foreground" Value="{StaticResource Yellow}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="failed">
                    <Setter Property="Foreground" Value="{StaticResource Red}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid Grid.Row="0" Background="#0F1218">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Border Width="24" Height="24" CornerRadius="7" Background="{StaticResource Orange}">
                    <TextBlock Text="R" FontWeight="Bold" FontSize="15" Foreground="#261207"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="RustGet" Margin="9,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Text="Download manager" Margin="10,0,0,0" VerticalAlignment="Center"
                           FontSize="11" Foreground="{StaticResource Muted}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,6,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource GhostIcon}" Content="—" Click="Minimize_Click" ToolTip="Minimize" />
                <Button Style="{StaticResource GhostIcon}" Content="▢" Click="Maximize_Click" ToolTip="Maximize" />
                <Button Style="{StaticResource GhostIcon}" Content="✕" Click="Close_Click" ToolTip="Close" />
            </StackPanel>
        </Grid>

        <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly">
            <Grid Width="1600" Height="960">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="224" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="318" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="{StaticResource Sidebar}"
                        BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                    <Grid Margin="14,18,14,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="LIBRARY" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource Muted}" Margin="10,0,0,6" />
                            <ListBox x:Name="FilterList" SelectionChanged="Filter_Changed">
                                <ListBoxItem Tag="all" IsSelected="True">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="All downloads" /><TextBlock x:Name="AllCount" Grid.Column="1" Foreground="{StaticResource Muted}" /></Grid>
                                </ListBoxItem>
                                <ListBoxItem Tag="downloading">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Downloading" /><TextBlock x:Name="DownloadingCount" Grid.Column="1" Foreground="{StaticResource Muted}" /></Grid>
                                </ListBoxItem>
                                <ListBoxItem Tag="queued">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Queued" /><TextBlock x:Name="QueuedCount" Grid.Column="1" Foreground="{StaticResource Muted}" /></Grid>
                                </ListBoxItem>
                                <ListBoxItem Tag="paused">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Paused" /><TextBlock x:Name="PausedCount" Grid.Column="1" Foreground="{StaticResource Muted}" /></Grid>
                                </ListBoxItem>
                                <ListBoxItem Tag="completed">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Completed" /><TextBlock x:Name="CompletedCount" Grid.Column="1" Foreground="{StaticResource Muted}" /></Grid>
                                </ListBoxItem>
                                <ListBoxItem Tag="failed">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Failed" /><TextBlock x:Name="FailedCount" Grid.Column="1" Foreground="{StaticResource Muted}" /></Grid>
                                </ListBoxItem>
                            </ListBox>
                            <TextBlock Text="CATEGORIES" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource Muted}" Margin="10,20,0,6" />
                            <ListBox x:Name="CategoryList" SelectionChanged="Filter_Changed">
                                <ListBoxItem Content="Archives" Tag="Archives" />
                                <ListBoxItem Content="Documents" Tag="Documents" />
                                <ListBoxItem Content="General" Tag="General" />
                                <ListBoxItem Content="Music" Tag="Music" />
                                <ListBoxItem Content="Programs" Tag="Programs" />
                                <ListBoxItem Content="Video" Tag="Video" />
                            </ListBox>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <Border Background="#171B22" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                    CornerRadius="8" Padding="10,8">
                                <StackPanel>
                                    <TextBlock Text="RustGet 0.1.0" FontSize="11" />
                                    <TextBlock Text="Rust engine · native XAML" FontSize="10"
                                               Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main -->
                <Grid Grid.Column="1" Margin="22,18,22,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="330" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="SectionTitle" Text="All downloads" FontSize="24" FontWeight="Bold" />
                            <TextBlock x:Name="SectionSubtitle" Text="Manage your downloads" FontSize="12"
                                       Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Grid Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                            <TextBox x:Name="SearchBox" Height="38" VerticalContentAlignment="Center"
                                     TextChanged="Search_Changed" ToolTip="Search downloads by name or URL" />
                            <TextBlock x:Name="SearchHint" Text="Search downloads" Foreground="{StaticResource Muted}"
                                       Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                        <Button x:Name="AddButton" Grid.Column="2" Style="{StaticResource Primary}"
                                Content="+  Add download" Click="Add_Click" Height="38"
                                VerticalAlignment="Center" ToolTip="Add a download URL" />
                    </Grid>

                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="ACTIVE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                <TextBlock x:Name="ActiveStat" Text="0" FontSize="26" FontWeight="Bold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="TOTAL SPEED" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                <TextBlock x:Name="SpeedStat" Text="0 B/s" FontSize="26" FontWeight="Bold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="COMPLETED" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                <TextBlock x:Name="CompletedStat" Text="0" FontSize="26" FontWeight="Bold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="DATA" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                <TextBlock x:Name="DataStat" Text="0 B" FontSize="26" FontWeight="Bold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="18,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="176" /><ColumnDefinition Width="104" /><ColumnDefinition Width="112" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="NAME" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                <TextBlock Grid.Column="1" Text="SIZE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                <TextBlock Grid.Column="2" Text="PROGRESS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                <TextBlock Grid.Column="3" Text="SPEED" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                                <TextBlock Grid.Column="4" Text="STATUS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                            </Grid>
                            <Grid Grid.Row="1">
                                <ListView x:Name="DownloadsList" Background="Transparent" BorderThickness="0"
                                          SelectionMode="Single" SelectionChanged="Selection_Changed"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="10,9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="84" />
                                                    <ColumnDefinition Width="176" /><ColumnDefinition Width="104" /><ColumnDefinition Width="112" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="10"
                                                               Foreground="{StaticResource Muted}" Margin="0,2,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="12"
                                                           VerticalAlignment="Center" Foreground="#C7CEDA" />
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,18,0">
                                                    <ProgressBar Value="{Binding Progress}" Maximum="100" Height="6"
                                                                 Foreground="{StaticResource Orange}" Background="#2A313D" />
                                                    <TextBlock Text="{Binding ProgressText}" FontSize="10"
                                                               Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" Text="{Binding SpeedText}" FontSize="12"
                                                           VerticalAlignment="Center" Foreground="#C7CEDA" />
                                                <Border Grid.Column="4" Style="{StaticResource StatusPill}">
                                                    <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                                            IsHitTestVisible="False">
                                    <Border Width="54" Height="54" CornerRadius="16" Background="#222833"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="↓" FontSize="26" Foreground="{StaticResource Orange}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="No downloads yet" FontSize="20" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                                    <TextBlock Text="Paste a URL or use Add download to start."
                                               Foreground="{StaticResource Muted}" Margin="0,6,0,0"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Details -->
                <Border Grid.Column="2" Background="{StaticResource Sidebar}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                    <Grid Margin="18,18,18,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="DETAILS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                            <TextBlock x:Name="DetailName" Text="Select a download" FontSize="18" FontWeight="SemiBold"
                                       Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="DetailStatus" Text="Choose an item from the list"
                                       FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,12" />
                            <ProgressBar x:Name="DetailProgress" Height="7" Maximum="100"
                                         Foreground="{StaticResource Orange}" Background="#2A313D" />
                        </StackPanel>

                        <StackPanel x:Name="DetailBody" Grid.Row="1" Margin="0,16,0,0" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}" Margin="0,0,6,0" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="DOWNLOADED" FontSize="9" Foreground="{StaticResource Muted}" />
                                        <TextBlock x:Name="DetailDownloaded" Text="—" FontSize="15" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,0" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="SPEED" FontSize="9" Foreground="{StaticResource Muted}" />
                                        <TextBlock x:Name="DetailSpeed" Text="—" FontSize="15" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock Text="SAVED TO" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,16,0,5" />
                            <TextBox x:Name="DetailPath" IsReadOnly="True" TextWrapping="Wrap" FontSize="11" />
                            <TextBlock Text="SOURCE" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Muted}" Margin="0,12,0,5" />
                            <TextBox x:Name="DetailUrl" IsReadOnly="True" TextWrapping="Wrap" FontSize="11" />
                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button Style="{StaticResource Action}" Content="Pause" Click="Pause_Click"
                                        Width="96" ToolTip="Pause selected download" />
                                <Button Style="{StaticResource Action}" Content="Resume" Click="Resume_Click"
                                        Width="96" ToolTip="Resume selected download" />
                            </StackPanel>
                            <Button Style="{StaticResource Action}" Content="Open folder" Click="OpenFolder_Click"
                                    Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                    ToolTip="Show the downloaded file in Explorer" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Viewbox>
    </Grid>
</Window>
