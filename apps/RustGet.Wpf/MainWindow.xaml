<Window x:Class="RustGet.Native.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RustGet" Height="840" Width="1280" MinHeight="640" MinWidth="1000"
        Background="#0E0F12" Foreground="#F4F1EC" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#17191E" />
        <SolidColorBrush x:Key="Panel2" Color="#1E2128" />
        <SolidColorBrush x:Key="Line" Color="#2A2E36" />
        <SolidColorBrush x:Key="Muted" Color="#8D939D" />
        <SolidColorBrush x:Key="Orange" Color="#FF8A4C" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F4F1EC" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style x:Key="Action" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Panel2}" />
            <Setter Property="Foreground" Value="#F4F1EC" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Action}">
            <Setter Property="Background" Value="{StaticResource Orange}" />
            <Setter Property="Foreground" Value="#1A0D06" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="{StaticResource Orange}" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#D8D4CE" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="Foreground" Value="#F4F1EC" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="310" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#13151A" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="4,6,0,22">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource Orange}">
                        <TextBlock Text="R" FontSize="24" FontWeight="Bold" Foreground="#241006"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,1,0,0">
                        <TextBlock Text="RustGet" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="FAST · OPEN · YOURS" FontSize="9" Foreground="{StaticResource Muted}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="LIBRARY" FontSize="10" Foreground="{StaticResource Muted}" Margin="8,0,0,6" />
                <ListBox x:Name="FilterList" Grid.Row="2" SelectionChanged="Filter_Changed">
                    <ListBoxItem Content="●  All downloads" Tag="all" IsSelected="True" />
                    <ListBoxItem Content="●  Downloading" Tag="downloading" />
                    <ListBoxItem Content="●  Queued" Tag="queued" />
                    <ListBoxItem Content="●  Paused" Tag="paused" />
                    <ListBoxItem Content="●  Completed" Tag="completed" />
                    <ListBoxItem Content="●  Failed" Tag="failed" />
                    <ListBoxItem Content="   CATEGORIES" IsEnabled="False" Margin="0,14,0,2" />
                    <ListBoxItem Content="●  Archives" Tag="Archives" />
                    <ListBoxItem Content="●  Documents" Tag="Documents" />
                    <ListBoxItem Content="●  General" Tag="General" />
                    <ListBoxItem Content="●  Music" Tag="Music" />
                    <ListBoxItem Content="●  Programs" Tag="Programs" />
                    <ListBoxItem Content="●  Video" Tag="Video" />
                </ListBox>
                <TextBlock Grid.Row="3" Text="Settings" Foreground="{StaticResource Muted}" Margin="12,10,0,8" />
            </Grid>
        </Border>

        <!-- Main -->
        <Grid Grid.Column="1" Margin="18,14,18,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Grid.Column="0" Height="38" VerticalContentAlignment="Center"
                         TextChanged="Search_Changed" ToolTip="Search downloads" />
                <Button Grid.Column="1" Style="{StaticResource Primary}" Content="+  Add download"
                        Click="Add_Click" Height="38" Margin="10,0,0,0" />
            </Grid>

            <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel><TextBlock Text="ACTIVE" FontSize="10" Foreground="{StaticResource Muted}" />
                        <TextBlock x:Name="ActiveStat" Text="0" FontSize="24" FontWeight="Bold" /></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel><TextBlock Text="TOTAL SPEED" FontSize="10" Foreground="{StaticResource Muted}" />
                        <TextBlock x:Name="SpeedStat" Text="0 B/s" FontSize="24" FontWeight="Bold" /></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel><TextBlock Text="COMPLETED" FontSize="10" Foreground="{StaticResource Muted}" />
                        <TextBlock x:Name="CompletedStat" Text="0" FontSize="24" FontWeight="Bold" /></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel><TextBlock Text="DATA" FontSize="10" Foreground="{StaticResource Muted}" />
                        <TextBlock x:Name="DataStat" Text="0 B" FontSize="24" FontWeight="Bold" /></StackPanel>
                </Border>
            </UniformGrid>

            <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="18,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" /><ColumnDefinition Width="90" />
                            <ColumnDefinition Width="190" /><ColumnDefinition Width="120" /><ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="NAME" FontSize="10" Foreground="{StaticResource Muted}" />
                        <TextBlock Grid.Column="1" Text="SIZE" FontSize="10" Foreground="{StaticResource Muted}" />
                        <TextBlock Grid.Column="2" Text="PROGRESS" FontSize="10" Foreground="{StaticResource Muted}" />
                        <TextBlock Grid.Column="3" Text="SPEED" FontSize="10" Foreground="{StaticResource Muted}" />
                        <TextBlock Grid.Column="4" Text="STATUS" FontSize="10" Foreground="{StaticResource Muted}" />
                    </Grid>
                    <ListView x:Name="DownloadsList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                              SelectionMode="Single" SelectionChanged="Selection_Changed">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="190" /><ColumnDefinition Width="120" /><ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="{StaticResource Muted}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" VerticalAlignment="Center" Foreground="#C9C5BE" />
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <ProgressBar Value="{Binding Progress}" Maximum="100" Height="6" Foreground="{StaticResource Orange}" />
                                        <TextBlock Text="{Binding ProgressText}" FontSize="10" Foreground="{StaticResource Muted}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding SpeedText}" VerticalAlignment="Center" Foreground="#C9C5BE" />
                                    <TextBlock Grid.Column="4" Text="{Binding Status}" VerticalAlignment="Center" Foreground="#7CE0B2" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- Details -->
        <Border Grid.Column="2" Background="#13151A" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18,18,18,14">
                    <TextBlock x:Name="DetailName" Text="Select a download" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DetailStatus" Text="No selection" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,2,0,12" />
                    <ProgressBar x:Name="DetailProgress" Height="7" Maximum="100" Foreground="{StaticResource Orange}" />
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,6,6">
                            <StackPanel><TextBlock Text="DOWNLOADED" FontSize="9" Foreground="{StaticResource Muted}" />
                                <TextBlock x:Name="DetailDownloaded" Text="—" FontSize="15" /></StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,6">
                            <StackPanel><TextBlock Text="SPEED" FontSize="9" Foreground="{StaticResource Muted}" />
                                <TextBlock x:Name="DetailSpeed" Text="—" FontSize="15" /></StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock Text="SAVED TO" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,10,0,4" />
                    <TextBox x:Name="DetailPath" IsReadOnly="True" TextWrapping="Wrap" FontSize="10" />
                    <TextBlock Text="SOURCE" FontSize="9" Foreground="{StaticResource Muted}" Margin="0,10,0,4" />
                    <TextBox x:Name="DetailUrl" IsReadOnly="True" TextWrapping="Wrap" FontSize="10" />
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource Action}" Content="Pause" Click="Pause_Click" />
                        <Button Style="{StaticResource Action}" Content="Resume" Click="Resume_Click" />
                    </StackPanel>
                    <Button Style="{StaticResource Action}" Content="Open folder" Click="OpenFolder_Click" Margin="0,8,0,0" HorizontalAlignment="Stretch" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
