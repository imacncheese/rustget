<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="RustGet"
           Language="1033"
           Version="0.1.0"
           Manufacturer="RustGet Contributors"
           UpgradeCode="7A2B63E4-5C7D-4F1A-9B2E-83D4C6A1F905">
    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Platform="x64"
             Description="RustGet download manager" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of RustGet is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="RustGetIcon" SourceFile="packaging\windows\rustget.ico" />
    <Property Id="ARPPRODUCTICON" Value="RustGetIcon" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />
    <UIRef Id="WixUI_FeatureTree" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="RustGet">
          <Component Id="MainExecutable" Guid="C5F0D2A1-8E4B-4C3A-9D61-2A7B5E8F4C10" Win64="yes">
            <File Id="RustGetExe"
                  Source="target\release\rustget.exe"
                  KeyPath="yes" />
          </Component>
          <Component Id="NativeShortcut" Guid="4A7D1E9C-3B62-4F0A-9E51-7C8D2A6B4F73" Win64="yes">
            <Shortcut Id="StartMenuShortcut"
                      Directory="ProgramMenuDir"
                      Name="RustGet"
                      Target="[INSTALLDIR]RustGet.Native.exe"
                      WorkingDirectory="INSTALLDIR"
                      Icon="RustGetIcon"
                      Advertise="no" />
            <RemoveFolder Id="RemoveProgramMenuDir" Directory="ProgramMenuDir" On="uninstall" />
            <RegistryValue Root="HKMU" Key="Software\RustGet" Name="NativeShortcut"
                           Type="integer" Value="1" KeyPath="yes" />
          </Component>
          <Component Id="NativeHost" Guid="E2A7B9C4-6D1F-4A8E-B305-9C7D1E4F2A63" Win64="yes">
            <File Id="NativeHostExe"
                  Source="target\release\rustget-native-host.exe"
                  KeyPath="yes" />
          </Component>
          <Component Id="TrayShell" Guid="1B4C6D8E-2F3A-4B5C-8D7E-6F9A0B1C2D34" Win64="yes">
            <File Id="TrayExe"
                  Source="target\release\rustget-tray.exe"
                  KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ProgramMenuDir" Name="RustGet" />
      </Directory>
      <Directory Id="DesktopFolder" />
    </Directory>

    <Component Id="DesktopShortcut" Guid="D2E6A1B4-7C39-4F58-A0D1-6B8E3C5A9F21" Win64="yes" Directory="DesktopFolder">
      <Shortcut Id="DesktopIcon"
                Directory="DesktopFolder"
                Name="RustGet"
                Target="[INSTALLDIR]RustGet.Native.exe"
                WorkingDirectory="INSTALLDIR"
                Icon="RustGetIcon" />
      <RegistryValue Root="HKMU" Key="Software\RustGet" Name="DesktopShortcut"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="MainFeature" Title="RustGet" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="NativeShortcut" />
      <ComponentRef Id="NativeHost" />
      <ComponentRef Id="TrayShell" />
      <ComponentGroupRef Id="NativeFiles" />
    </Feature>
    <Feature Id="DesktopIconFeature" Title="Desktop shortcut" Description="Create a RustGet icon on the desktop." Level="1">
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
  </Product>
</Wix>
