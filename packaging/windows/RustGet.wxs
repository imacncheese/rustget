<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="RustGet"
           Language="1033"
           Version="0.1.0"
           Manufacturer="RustGet Contributors"
           UpgradeCode="7A2B63E4-5C7D-4F1A-9B2E-83D4C6A1F905">
    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Platform="x64"
             Description="RustGet download manager" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of RustGet is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="RustGet">
          <Component Id="MainExecutable" Guid="C5F0D2A1-8E4B-4C3A-9D61-2A7B5E8F4C10" Win64="yes">
            <File Id="RustGetExe"
                  Source="target\release\rustget.exe"
                  KeyPath="yes" />
          </Component>
          <Component Id="DesktopShell" Guid="9F3C2A7B-4E1D-4B8A-8C6F-5A2D7E9B1C40" Win64="yes">
            <File Id="DesktopExe"
                  Source="target\release\rustget-desktop.exe"
                  KeyPath="yes">
              <Shortcut Id="StartMenuShortcut"
                        Directory="ProgramMenuDir"
                        Name="RustGet"
                        WorkingDirectory="INSTALLDIR"
                        Advertise="no" />
            </File>
            <File Id="WebView2Loader" Source="packaging\windows\WebView2Loader.dll" />
            <RemoveFolder Id="RemoveProgramMenuDir" Directory="ProgramMenuDir" On="uninstall" />
          </Component>
          <Component Id="NativeHost" Guid="E2A7B9C4-6D1F-4A8E-B305-9C7D1E4F2A63" Win64="yes">
            <File Id="NativeHostExe"
                  Source="target\release\rustget-native-host.exe"
                  KeyPath="yes" />
          </Component>
          <Component Id="TrayShell" Guid="1B4C6D8E-2F3A-4B5C-8D7E-6F9A0B1C2D34" Win64="yes">
            <File Id="TrayExe"
                  Source="target\release\rustget-tray.exe"
                  KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ProgramMenuDir" Name="RustGet" />
      </Directory>
    </Directory>

    <Feature Id="MainFeature" Title="RustGet" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="DesktopShell" />
      <ComponentRef Id="NativeHost" />
      <ComponentRef Id="TrayShell" />
    </Feature>
  </Product>
</Wix>
